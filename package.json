{
  "name": "@liberland/marketplace-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-chain Liberland Marketplace token and swap contracts",
  "packageManager": "yarn@1.22.22",
  "exports": {
    ".": "./src/index.ts",
    "./deployment/browser": "./src/deployment/browser.ts",
    "./client/ethereum": "./src/client/ethereum.ts",
    "./client/thirdweb": "./src/client/thirdweb.ts",
    "./client/tron": "./src/client/tron.ts",
    "./client/solana": "./src/client/solana.ts"
  },
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "format": "prettier --write \"contracts/**/*.sol\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"contracts/**/*.sol\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "deploy": "tsx scripts/deploy.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.9",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.30",
    "hardhat": "^2.28.0",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^2.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "@solana/web3.js": "^1.98.4",
    "@uniswap/v4-core": "^1.0.2",
    "@uniswap/v4-periphery": "^1.0.3",
    "ethers": "^6.17.0",
    "solmate": "^6.8.0",
    "thirdweb": "^5.121.1",
    "tronweb": "^6.5.0"
  }
}
