{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "mocha",
      "@nomicfoundation/hardhat-ethers",
      "@openzeppelin/hardhat-upgrades"
    ]
  },
  "include": ["hardhat.config.ts", "scripts", "src", "test"]
}
